# MLflow
# Local server uses 5001 because macOS AirPlay can occupy port 5000.
# Inside Docker, use http://host.docker.internal:5001 instead.
MLFLOW_TRACKING_URI="http://127.0.0.1:5001"
MLFLOW_EXPERIMENT_NAME="finbert-evaluation"
MODEL_NAME="finbert"
MODEL_STAGE=production

# AWS / ECR
AWS_REGION=""
AWS_ACCOUNT_ID=""   
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
ECR_REPOSITORY=""

# Model source: "mlflow" (default) or "huggingface" (CI/prod)
MODEL_SOURCE=mlflow
HF_MODEL_ID=baptle/FinBERT_market_based
HF_MODEL_REVISION=ec5ffa074fc00da4de8b28554a57aa1debf92508
MODEL_NUM_THREADS=2
HF_DATASET_ID=baptle/financial_headlines_market_based

# API
API_HOST=0.0.0.0
API_PORT=8000
